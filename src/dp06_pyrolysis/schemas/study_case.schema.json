{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PyrolysisFramework_StudyCase_v1",
  "title": "Pyrolysis Modelling Framework StudyCase",
  "type": "object",
  "required": [
    "case_metadata",
    "feedstock",
    "regime",
    "model_request",
    "outputs_requested"
  ],
  "additionalProperties": false,
  "properties": {
    "case_metadata": {
      "type": "object",
      "required": [
        "case_id",
        "purpose",
        "evidence_intent"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "evidence_intent": {
          "enum": [
            "screening",
            "diagnostic",
            "reproduction",
            "validation",
            "optimization",
            "exploratory"
          ]
        }
      }
    },
    "feedstock": {
      "type": "object",
      "required": [
        "feedstock_id",
        "family",
        "name",
        "source_type",
        "provenance_id",
        "proximate_analysis"
      ],
      "additionalProperties": false,
      "properties": {
        "feedstock_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "lignocellulosic_biomass",
            "agricultural_residue",
            "cattle_manure",
            "camel_dung",
            "plastic_single",
            "plastic_mixture",
            "biomass_plastic_mixture"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "proximate_analysis": {
          "type": "object",
          "required": ["basis","quality_status","values","complete_balance"],
          "additionalProperties": false,
          "properties": {
            "basis": {"enum": ["as_received","dry","dry_ash_free"]},
            "quality_status": {"enum": ["measured_primary","measured_secondary_source","derived","estimated","assumed","missing"]},
            "values": {"type": "object","minProperties": 1,"additionalProperties": {"type": "number","minimum": 0.0,"maximum": 1.0}},
            "complete_balance": {"type": "boolean"},
            "source_ref": {"type": ["string","null"]},
            "method": {"type": ["string","null"]},
            "oxygen_method": {"type": ["string","null"]}
          }
        },
        "ultimate_analysis": {
          "anyOf": [
            {"type": "object","required": ["basis","quality_status","values","complete_balance"],"additionalProperties": false,"properties": {"basis": {"enum": ["as_received","dry","dry_ash_free"]},"quality_status": {"enum": ["measured_primary","measured_secondary_source","derived","estimated","assumed","missing"]},"values": {"type": "object","minProperties": 1,"additionalProperties": {"type": "number","minimum": 0.0,"maximum": 1.0}},"complete_balance": {"type": "boolean"},"source_ref": {"type": ["string","null"]},"method": {"type": ["string","null"]},"oxygen_method": {"type": ["string","null"]}}},
            {"type": "null"}
          ]
        },
        "biochemical_composition": {
          "anyOf": [
            {"type": "object","required": ["basis","quality_status","values","complete_balance"],"additionalProperties": false,"properties": {"basis": {"enum": ["as_received","dry","dry_ash_free"]},"quality_status": {"enum": ["measured_primary","measured_secondary_source","derived","estimated","assumed","missing"]},"values": {"type": "object","minProperties": 1,"additionalProperties": {"type": "number","minimum": 0.0,"maximum": 1.0}},"complete_balance": {"type": "boolean"},"source_ref": {"type": ["string","null"]},"method": {"type": ["string","null"]},"oxygen_method": {"type": ["string","null"]}}},
            {"type": "null"}
          ]
        },
        "polymer_composition": {
          "anyOf": [
            {"type": "object","required": ["basis","quality_status","values","complete_balance"],"additionalProperties": false,"properties": {"basis": {"enum": ["as_received","dry","dry_ash_free"]},"quality_status": {"enum": ["measured_primary","measured_secondary_source","derived","estimated","assumed","missing"]},"values": {"type": "object","minProperties": 1,"additionalProperties": {"type": "number","minimum": 0.0,"maximum": 1.0}},"complete_balance": {"type": "boolean"},"source_ref": {"type": ["string","null"]},"method": {"type": ["string","null"]},"oxygen_method": {"type": ["string","null"]}}},
            {"type": "null"}
          ]
        },
        "mineral_composition": {
          "anyOf": [
            {"type": "object","required": ["basis","quality_status","values","complete_balance"],"additionalProperties": false,"properties": {"basis": {"enum": ["as_received","dry","dry_ash_free"]},"quality_status": {"enum": ["measured_primary","measured_secondary_source","derived","estimated","assumed","missing"]},"values": {"type": "object","minProperties": 1,"additionalProperties": {"type": "number","minimum": 0.0,"maximum": 1.0}},"complete_balance": {"type": "boolean"},"source_ref": {"type": ["string","null"]},"method": {"type": ["string","null"]},"oxygen_method": {"type": ["string","null"]}}},
            {"type": "null"}
          ]
        },
        "physical_properties": {"type": "object","additionalProperties": {"type": "number"}}
      }
    },
    "regime": {
      "type": "object",
      "required": ["thermal_program","pressure_Pa","atmosphere"],
      "additionalProperties": false,
      "properties": {
        "thermal_program": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["linear_ramp","isothermal","time_temperature_profile"]},
            "T_initial_K": {"type": ["number","null"],"exclusiveMinimum": 0},
            "T_final_K": {"type": ["number","null"],"exclusiveMinimum": 0},
            "heating_rate_K_per_s": {"type": ["number","null"],"exclusiveMinimum": 0},
            "T_K": {"type": ["number","null"],"exclusiveMinimum": 0},
            "hold_time_s": {"type": ["number","null"],"minimum": 0},
            "profile": {"type": ["array","null"],"items": {"type": "array","minItems": 2,"maxItems": 2,"prefixItems": [{"type": "number","minimum": 0},{"type": "number","exclusiveMinimum": 0}],"items": false}}
          }
        },
        "pressure_Pa": {"type": "number","exclusiveMinimum": 0},
        "atmosphere": {"type": "object","required": ["class","mole_fractions"],"additionalProperties": false,"properties": {"class": {"enum": ["inert","co2_containing","steam_containing","oxidative","autothermal_candidate","custom"]},"mole_fractions": {"type": "object","minProperties": 1,"additionalProperties": {"type": "number","minimum": 0.0,"maximum": 1.0}}}},
        "vapor_residence_time_s": {"type": ["number","null"],"minimum": 0},
        "solid_residence_time_s": {"type": ["number","null"],"minimum": 0},
        "equivalence_ratio": {"type": ["number","null"],"minimum": 0}
      }
    },
    "model_request": {"type": "object","required": ["requested_fidelity","selection_mode"],"additionalProperties": false,"properties": {"requested_fidelity": {"type": "string","minLength": 1},"selection_mode": {"type": "string","minLength": 1},"requested_model_id": {"type": ["string","null"]}}},
    "outputs_requested": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "string","minLength": 1}},
    "validation_context": {"type": "object"},
    "optimization_request": {"type": ["object","null"]}
  }
}